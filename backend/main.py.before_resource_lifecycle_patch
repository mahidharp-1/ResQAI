# SAFEROUTE
# ============================================================

@app.post("/api/routes/recommend")
async def route(
    req: RouteRequest,
    db: Session = Depends(get_db)
):

    try:

        # =====================================================
        # CURRENT / OPERATIONAL HAZARDS
        # =====================================================

        hazards = (
            db.query(Hazard)
            .all()
        )

        hazard_data = [
            hazard_dict(x)
            for x in hazards
        ]

        # =====================================================
        # HISTORICAL HAZARDS
        # =====================================================

        historical_records = (
            db.query(DatasetHazard)
            .all()
        )

        historical_hazard_data = [
            {
                "source_id": x.source_id,
                "hazard_type": x.hazard_type,
                "type": x.hazard_type,
                "severity": x.severity,
                "latitude": x.latitude,
                "longitude": x.longitude,
                "source": "historical",
            }
            for x in historical_records
        ]

        # =====================================================
        # SAFE ROUTE
        # =====================================================

        result = await recommend_route(
            req.origin_lat,
            req.origin_lon,
            req.destination_lat,
            req.destination_lon,
            hazard_data,
            historical_hazard_data,
        )

        return result

    except Exception as e:

        raise HTTPException(
            status_code=500,
            detail=(
                f"Route recommendation failed: {str(e)}"
            )
        )


